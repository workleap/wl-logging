{
    "name": "@workleap/logging",
    "version": "2.1.0",
    "description": "A package including logging utilities for Workleap web applications.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-logging.git",
        "directory": "packages/logging"
    },
    "files": [
        "src",
        "dist",
        "skills",
        "CHANGELOG.md"
    ],
    "type": "module",
    "sideEffects": false,
    "exports": "./src/index.ts",
    "publishConfig": {
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            }
        },
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "prepack": "node ./scripts/agent-skill.mjs copy",
        "postpack": "node ./scripts/agent-skill.mjs clean",
        "build": "rslib build --config ./rslib.build.ts",
        "typecheck": "tsc",
        "test": "vitest --config vitest.config.ts --no-watch"
    },
    "devDependencies": {
        "@rsbuild/core": "2.3.1",
        "@rslib/core": "1.0.6",
        "@workleap/rslib-configs": "2.1.1",
        "@workleap/typescript-configs": "5.1.0",
        "vitest": "5.1.0"
    }
}
