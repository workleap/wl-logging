{
    "name": "workspace-root",
    "version": "0.0.0",
    "private": true,
    "description": "Logging libraries for building web applications at Workleap.",
    "license": "Apache-2.0",
    "author": "Workleap",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/workleap/wl-logging.git"
    },
    "type": "module",
    "scripts": {
        "dev-web": "turbo run dev --filter=./samples/web",
        "dev-docs": "retype start",
        "build-pkg": "turbo run build --filter=./packages/*",
        "lint": "turbo run lint --continue",
        "oxlint": "oxlint --deny-warnings --report-unused-disable-directives-severity=error",
        "oxfmt": "oxfmt",
        "oxfmt:check": "oxfmt --check",
        "typecheck": "tsc",
        "syncpack": "syncpack lint",
        "test": "turbo run test --continue",
        "changeset": "changeset",
        "publish-pkg": "changeset publish",
        "publish-pr-pkg": "pkg-pr-new publish ./packages/* --packageManager=pnpm --pnpm",
        "clean": "pnpm -r --parallel --include-workspace-root exec pnpm dlx rimraf dist .turbo .rslib node_modules/.cache",
        "reset": "pnpm clean && pnpm reset:modules",
        "strip-lockfile-tarballs": "node ./scripts/strip-lockfile-tarballs.mjs",
        "reset:modules": "pnpm -r --parallel --include-workspace-root exec pnpm dlx rimraf node_modules pnpm-lock.yaml",
        "list-outdated-deps": "pnpm outdated -r --format list !typescript",
        "update-outdated-deps": "pnpm run --sequential \"/^update-outdated-deps:.*/\"",
        "update-outdated-deps:update-version": "pnpm update -r --latest !typescript",
        "update-outdated-deps:update-peers": "syncpack fix",
        "update-outdated-deps:fix-pkg-json": "oxfmt package.json **/package.json"
    },
    "devDependencies": {
        "@changesets/changelog-github": "1.0.1",
        "@changesets/cli": "3.0.3",
        "@types/node": "26.6.5",
        "@typescript/native-preview": "7.0.0-dev.20260707.2",
        "@workleap/typescript-configs": "5.0.0",
        "agent-browser": "0.39.1",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "pkg-pr-new": "0.0.91",
        "retypeapp": "4.6.0",
        "syncpack": "15.3.3",
        "turbo": "2.11.9",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=26.0.0",
        "pnpm": ">=12"
    },
    "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
